# ==========================================
# Codev - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Codev"

# Security & JWT
SECRET_KEY=codev_super_secret_jwt_signing_key_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Legacy / pgvector (optional):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codev

# MongoDB (Primary Store — WiredTiger snappy compression)
MONGODB_URL=mongodb://localhost:27017/codev_db
MONGODB_DB_NAME=codev_db
# Atlas example: MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/codev_db

# Vector Storage Engine ('auto', 'pgvector', 'memory')
VECTOR_STORE_BACKEND=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# AI LLM Provider Keys (Optional - Intelligent Built-in Reasoner used as fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# GitHub OAuth / Integration (Optional - PAT & URL ingestion enabled out-of-the-box)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# Storage directory for cloned repositories
REPO_CACHE_DIR=./storage/repos
